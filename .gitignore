out/
__pycache__/
*.pyc
assets/bgm/
.venv/
archive/CASE-*/

# 素材图片必须入库 —— 云端会话的出网策略拦截了所有图片站，
# git 是把图片送进渲染环境的唯一通路。
# 只排除我为验证排版生成的合成占位图。
topics/assets/_synthetic/

# 音频不入库：往仓库里放有授权的音乐等于再分发，仓库一旦公开就是问题。
# 授权登记（licenses.yaml）要入库，音频本身不要。
assets/bgm/**/*.mp3
assets/bgm/**/*.m4a
assets/bgm/**/*.wav
assets/bgm/**/*.ogg
